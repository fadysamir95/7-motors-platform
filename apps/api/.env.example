DATABASE_URL="postgresql://motors:motors@localhost:5435/motors?schema=public"
# Required, min 32 chars, no placeholder values (the API refuses to boot otherwise).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
REDIS_URL="redis://localhost:6379"
PORT=3001
FRONTEND_URL="http://localhost:3000"

# Used only by `prisma/seed.ts`. If SEED_ADMIN_PASSWORD is empty, a random
# password is generated and printed once.
SEED_ADMIN_EMAIL="admin@7motors.com"
SEED_ADMIN_PASSWORD=

# Number of reverse proxies / load balancers in front of the API (0 or empty when none).
# Needed so rate limiting and the audit log see real client addresses.
TRUST_PROXY=
